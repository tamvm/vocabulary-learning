# Magic English Frontend Environment Variables

# API Configuration — production uses the same host as the UI
VITE_API_URL=https://voca.kenchange.com/api

# Supabase Configuration (for direct client access)
# Must be a resolvable https://<project-ref>.supabase.co URL (NXDOMAIN breaks Google OAuth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# App Configuration
VITE_APP_NAME=Magic English
VITE_APP_VERSION=1.0.0