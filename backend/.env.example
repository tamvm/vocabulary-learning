# Magic English Backend Environment Variables

# Server Configuration
NODE_ENV=production
PORT=5000

# Frontend URL (for CORS) — production origin
FRONTEND_URL=https://voca.kenchange.com

# Supabase Configuration
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider Configuration
# AI Configuration (OpenAI-compatible providers)
# OpenCode Go:
#   AI_PROVIDER=opencode   (or opencode-go)
#   AI_API_KEY=<your OpenCode Go key>   (OPENCODE_API_KEY also accepted)
#   AI_MODEL=kimi-k2.7-code   (avoid deepseek-v4-flash — flaky on Go)
AI_PROVIDER=opencode
AI_API_KEY=your-opencode-go-api-key
AI_MODEL=kimi-k2.7-code

# Ollama Local Configuration (if using ollama-local provider)
OLLAMA_LOCAL_HOST=http://localhost:11434

# JWT Secret (for custom JWT operations if needed)
JWT_SECRET=your-jwt-secret-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Transcript24 (YouTube /learn primary captions; from Hermes on Tony Mac)
# Docs: https://www.transcript24.com/transcript-api
TRANSCRIPT24_API_KEY=